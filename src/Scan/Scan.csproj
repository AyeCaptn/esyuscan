<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>esyuscan</AssemblyName>
    <RootNamespace>Scan</RootNamespace>
    <Version>0.1.0</Version>
    <RuntimeIdentifiers>linux-arm64;linux-x64</RuntimeIdentifiers>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.HarfBuzz" Version="12.1.4" />
    <PackageReference Include="Avalonia.Skia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Wayland" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Simple" Version="12.1.4" />
    <PackageReference Include="NAPS2.Sdk" Version="1.6.0" />
    <PackageReference Include="NAPS2.Images.Gtk" Version="1.6.0" />
    <!-- Lossless AirScan responses can be PDFs, even when saving scanned images. -->
    <PackageReference Include="NAPS2.Pdfium.Binaries" Version="1.3.0" />
  </ItemGroup>
</Project>
