<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Scan.App" RequestedThemeVariant="Dark">
  <Application.Resources>
    <FontFamily x:Key="AppFont">monospace</FontFamily>
    <CornerRadius x:Key="AppRadius">8</CornerRadius>
  </Application.Resources>
  <Application.Styles>
    <SimpleTheme />
    <Style Selector="Window">
      <Setter Property="Background" Value="{DynamicResource BackgroundBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
      <Setter Property="FontFamily" Value="{DynamicResource AppFont}" />
      <Setter Property="FontSize" Value="11" />
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="{DynamicResource SecondaryBrush}" />
    </Style>
    <Style Selector="TextBlock.eyebrow">
      <Setter Property="FontSize" Value="10" />
      <Setter Property="LetterSpacing" Value="1.8" />
      <Setter Property="Foreground" Value="{DynamicResource SecondaryBrush}" />
    </Style>
    <Style Selector="Button">
      <Setter Property="CornerRadius" Value="{DynamicResource AppRadius}" />
      <Setter Property="Background" Value="{DynamicResource RaisedBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="12,5" />
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SelectionBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
      <Setter Property="Opacity" Value="0.85" />
    </Style>
    <Style Selector="Button.quiet">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="ComboBox">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="Background" Value="{DynamicResource BackgroundBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="CornerRadius" Value="{DynamicResource AppRadius}" />
      <Setter Property="Padding" Value="8,5" />
      <Setter Property="MinHeight" Value="28" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="Background" Value="{DynamicResource BackgroundBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="CornerRadius" Value="{DynamicResource AppRadius}" />
      <Setter Property="Padding" Value="8,5" />
      <Setter Property="MinHeight" Value="28" />
    </Style>
    <Style Selector="CheckBox">
      <Setter Property="MinHeight" Value="24" />
      <Setter Property="Padding" Value="8,0,0,0" />
    </Style>
    <Style Selector="ListBox">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="ListBoxItem">
      <Setter Property="Padding" Value="6" />
      <Setter Property="Margin" Value="0,0,10,0" />
      <Setter Property="CornerRadius" Value="{DynamicResource AppRadius}" />
    </Style>
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SelectionBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="ProgressBar">
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
      <Setter Property="Background" Value="{DynamicResource RaisedBrush}" />
    </Style>
  </Application.Styles>
</Application>
