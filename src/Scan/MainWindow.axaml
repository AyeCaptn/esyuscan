<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:Scan"
        x:Class="Scan.MainWindow" x:DataType="local:MainViewModel"
        Title="esyuscan · Document scanning" Width="1280" Height="900"
        MinWidth="760" MinHeight="680">
  <Window.Styles>
    <Style Selector="ListBox#PageTray">
      <Setter Property="Width" Value="96" />
      <Setter Property="Padding" Value="4" />
    </Style>
    <Style Selector="ListBox#PageTray ListBoxItem">
      <Setter Property="Margin" Value="0,0,0,6" />
      <Setter Property="Padding" Value="5" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="ListBox#PageTray Image">
      <Setter Property="Height" Value="78" />
      <Setter Property="Width" Value="58" />
    </Style>
    <Style Selector="Grid.document-area">
      <Setter Property="RowSpacing" Value="6" />
      <Setter Property="ColumnSpacing" Value="8" />
    </Style>
    <Style Selector="Border.export-footer">
      <Setter Property="Padding" Value="14,8" />
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    </Style>
    <Style Selector="Grid.export-layout">
      <Setter Property="RowSpacing" Value="4" />
    </Style>
    <Style Selector="Border.export-footer Button">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Padding" Value="10,4" />
    </Style>
    <Style Selector="Border.export-footer CheckBox">
      <Setter Property="FontSize" Value="11" />
    </Style>
    <Style Selector="Border.export-footer ComboBox">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Padding" Value="8,4" />
    </Style>
    <Style Selector="Border#PreviewPanel Button">
      <Setter Property="MinHeight" Value="24" />
      <Setter Property="Padding" Value="8,3" />
    </Style>
    <Style Selector="Window.compact TextBlock#OcrStatusText">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Window.compact Button">
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="FontSize" Value="10" />
    </Style>
    <Style Selector="Window.compact Grid.document-area">
      <Setter Property="Margin" Value="8" />
    </Style>
    <Style Selector="Window.compact ListBox#PageTray">
      <Setter Property="Width" Value="80" />
    </Style>
    <Style Selector="Window.compact WrapPanel#PageToolbar Button">
      <Setter Property="Padding" Value="6,4" />
    </Style>
    <Style Selector="Window.short Border.export-footer">
      <Setter Property="Padding" Value="12,6" />
    </Style>
    <Style Selector="Window.short ListBox#PageTray Image">
      <Setter Property="Height" Value="70" />
      <Setter Property="Width" Value="52" />
    </Style>
    <Style Selector="TextBlock.shortcut-hint">
      <Setter Property="FontSize" Value="9" />
      <Setter Property="Opacity" Value="0.75" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Window.compact TextBlock.shortcut-hint">
      <Setter Property="FontSize" Value="8" />
    </Style>
  </Window.Styles>
  <Grid x:Name="RootGrid" RowDefinitions="48,*,Auto">
    <Border x:Name="TopBar" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="14,0">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Border Background="{DynamicResource AccentBrush}" Width="26" Height="30" CornerRadius="{DynamicResource AppRadius}">
            <PathIcon Width="14" Height="19" Foreground="{DynamicResource AccentTextBrush}"
                      Data="M3,1 L14,1 L20,7 L20,25 L3,25 Z M13,1 L13,8 L20,8 M7,13 L16,13 M7,18 L16,18" />
          </Border>
          <TextBlock Text="esyuscan" FontSize="18" FontWeight="SemiBold" LetterSpacing="-1" VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
          <TextBlock x:Name="SessionNameText" Text="{Binding SessionName}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding SessionName}" />
          <TextBlock x:Name="SessionPathText" Text="{Binding SessionPath}" Classes="muted" FontSize="9" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding SessionPath}" />
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
          <Button x:Name="NewSessionButton" Content="New" Click="NewSession" IsEnabled="{Binding CanEdit}" />
          <Button x:Name="OpenSessionButton" Content="Open" Click="OpenSession" IsEnabled="{Binding CanEdit}" Classes="quiet" />
          <Button x:Name="ImportFilesButton" Content="Import…" Click="ImportFiles" IsEnabled="{Binding CanEdit}" Classes="quiet" />
          <Button x:Name="SettingsButton" Content="Settings" Classes="quiet">
            <Button.Flyout>
              <Flyout Placement="BottomEdgeAlignedRight">
                <ScrollViewer x:Name="SettingsMenu" Width="380" MaxHeight="460" HorizontalScrollBarVisibility="Disabled">
                  <StackPanel Spacing="16" Margin="4">
                    <TextBlock Text="SETTINGS" Classes="eyebrow" />
                    <Expander x:Name="PresetEditor" Header="Save / manage presets" HorizontalAlignment="Stretch">
                      <StackPanel Spacing="8" Margin="0,8,0,0">
                        <TextBlock Text="{Binding SelectedPreset.Name, TargetNullValue='No saved preset selected'}" Classes="muted" FontSize="11" />
                        <TextBox x:Name="PresetNameBox" Text="{Binding PresetName}" PlaceholderText="Preset name" MaxLength="80" IsEnabled="{Binding CanConfigure}" />
                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="6" RowSpacing="6">
                          <Button x:Name="SavePresetButton" Content="Save new" Click="SavePreset" IsEnabled="{Binding CanSavePreset}" HorizontalAlignment="Stretch" />
                          <Button x:Name="RenamePresetButton" Grid.Column="1" Content="Rename" Click="RenamePreset" IsEnabled="{Binding CanManagePreset}" HorizontalAlignment="Stretch" />
                          <Button x:Name="UpdatePresetButton" Grid.Row="1" Content="Update" Click="UpdatePreset" IsEnabled="{Binding CanUpdatePreset}" HorizontalAlignment="Stretch" ToolTip.Tip="Replace this preset's settings with the current scan settings" />
                          <Button x:Name="DeletePresetButton" Grid.Row="1" Grid.Column="1" Content="Delete" Click="DeletePreset" IsEnabled="{Binding CanManagePreset}" HorizontalAlignment="Stretch" />
                        </Grid>
                        <Button x:Name="ImportNaps2ProfilesButton" Content="Import NAPS2 profiles…" Click="ImportNaps2Profiles" IsEnabled="{Binding CanConfigure}" HorizontalAlignment="Stretch" />
                      </StackPanel>
                    </Expander>
                    <Expander x:Name="ManualDeviceEditor" Header="Manual scanner address" HorizontalAlignment="Stretch">
                      <StackPanel Spacing="8" Margin="0,8,0,0" IsEnabled="{Binding CanConfigure}">
                        <TextBlock Text="{Binding SelectedDevice.Name, TargetNullValue='No scanner selected'}" Classes="muted" FontSize="11" />
                        <ComboBox x:Name="ManualDriverPicker" ItemsSource="{Binding ManualDriverChoices}" SelectedItem="{Binding ManualDriver}" />
                        <TextBlock Text="AirScan: host or HTTP(S) URL. SANE: exact backend device ID." TextWrapping="Wrap" FontSize="11" Classes="muted" />
                        <TextBox x:Name="ManualAddressBox" Text="{Binding ManualAddress}" PlaceholderText="Address / backend ID" MaxLength="2048" />
                        <TextBox Text="{Binding ManualName}" PlaceholderText="Name (optional)" MaxLength="80" />
                        <Button x:Name="AddManualDeviceButton" Content="Validate and save" Click="AddManualDevice" HorizontalAlignment="Stretch" />
                        <Button x:Name="RemoveManualDeviceButton" Content="Forget selected address" Click="RemoveManualDevice" IsEnabled="{Binding CanRemoveManualDevice}" HorizontalAlignment="Stretch" />
                        <TextBlock Text="Validation reads capabilities only. Cancel operation stops waiting for the scanner; some native SANE calls must return first." TextWrapping="Wrap" FontSize="11" Classes="muted" />
                      </StackPanel>
                    </Expander>
                    <Expander x:Name="ScanGeometryEditor" Header="Paper geometry / area" HorizontalAlignment="Stretch">
                      <StackPanel Spacing="8" Margin="0,8,0,0" IsEnabled="{Binding CanChangeScanSettings}">
                        <TextBlock Text="Units" FontSize="11" Classes="muted" />
                        <ComboBox x:Name="GeometryUnitPicker" ItemsSource="{Binding GeometryUnits}" SelectedItem="{Binding GeometryUnit}" />
                        <TextBlock Text="Custom paper dimensions" FontSize="11" Classes="muted" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="6" IsEnabled="{Binding CanEditCustomSize}">
                          <StackPanel Spacing="4"><TextBlock Text="Width" FontSize="11" /><TextBox x:Name="PaperWidthBox" Text="{Binding PaperWidth}" /></StackPanel>
                          <StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="Height" FontSize="11" /><TextBox x:Name="PaperHeightBox" Text="{Binding PaperHeight}" /></StackPanel>
                        </Grid>
                        <TextBlock Text="Paper alignment" FontSize="11" Classes="muted" />
                        <ComboBox x:Name="AlignmentPicker" ItemsSource="{Binding AlignmentChoices}" SelectedItem="{Binding SelectedAlignment}" />
                        <CheckBox x:Name="SelectScanAreaCheckBox" IsChecked="{Binding SelectScanArea}"><TextBlock Text="Keep selected scan area" TextWrapping="Wrap" FontSize="11" /></CheckBox>
                        <Grid x:Name="ScanAreaFields" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="6" RowSpacing="6" IsVisible="{Binding SelectScanArea}">
                          <StackPanel Spacing="4"><TextBlock Text="X / left" FontSize="11" /><TextBox x:Name="AreaXBox" Text="{Binding AreaX}" /></StackPanel>
                          <StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="Y / top" FontSize="11" /><TextBox x:Name="AreaYBox" Text="{Binding AreaY}" /></StackPanel>
                          <StackPanel Grid.Row="1" Spacing="4"><TextBlock Text="Width" FontSize="11" /><TextBox x:Name="AreaWidthBox" Text="{Binding AreaWidth}" /></StackPanel>
                          <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4"><TextBlock Text="Height" FontSize="11" /><TextBox x:Name="AreaHeightBox" Text="{Binding AreaHeight}" /></StackPanel>
                        </Grid>
                        <local:ScanGeometryPreview x:Name="ScanGeometryPreview" Diagram="{Binding GeometryDiagram}" Height="110" />
                        <TextBlock Text="Outline: source bounds. Shaded: paper. Thick border: kept area. Dot: paper origin." TextWrapping="Wrap" FontSize="10" Classes="muted" />
                        <TextBlock x:Name="GeometryExplanation" Text="{Binding GeometryExplanation}" TextWrapping="Wrap" FontSize="11" Classes="muted" />
                        <TextBlock Text="{Binding GeometryError}" IsVisible="{Binding HasGeometryError}" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource ErrorBrush}" />
                      </StackPanel>
                    </Expander>
                    <CheckBox x:Name="AutoDeskewCheckBox" Content="Auto-deskew scans" IsChecked="{Binding AutoDeskew}" IsEnabled="{Binding CanConfigure}"
                              ToolTip.Tip="Straighten scans before their original PNG is saved. Later page edits remain undoable." />
                    <Button x:Name="OcrLanguagesButton" Content="OCR languages / models…" Click="ShowOcrLanguages" IsEnabled="{Binding CanConfigure}" HorizontalAlignment="Stretch" />
                    <Expander Header="Scanner discovery details" HorizontalAlignment="Stretch">
                      <TextBlock x:Name="DiscoveryExplanation" Text="{Binding DiscoveryExplanation}" TextWrapping="Wrap" FontSize="11" Classes="muted" Margin="0,8,0,0" />
                    </Expander>
                    <Button x:Name="PrinterSettingsButton" Content="System printer settings ↗" Classes="quiet" HorizontalAlignment="Left" Click="PrinterSettings"
                            ToolTip.Tip="Opens the system printer manager in a separate window. Its appearance follows your desktop's GTK theme." />
                    <TextBlock Text="{Binding ThemeStatus}" FontSize="11" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap" />
                  </StackPanel>
                </ScrollViewer>
              </Flyout>
            </Button.Flyout>
          </Button>
          <Button x:Name="HelpButton" Content="?" Click="ShowHelp" Classes="quiet" ToolTip.Tip="Keyboard shortcuts" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid x:Name="WorkspaceGrid" Grid.Row="1" ColumnDefinitions="252,*">
      <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0" Padding="12">
        <Grid RowDefinitions="*,Auto">
          <ScrollViewer x:Name="ScanSettingsScroller" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="16">
            <Border IsVisible="{Binding HasDuplex}" Background="{DynamicResource RaisedBrush}"
                    BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="{DynamicResource AppRadius}" Padding="12">
              <StackPanel Spacing="8">
                <TextBlock Text="{Binding DuplexTitle}" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="{Binding DuplexInstructions}" TextWrapping="Wrap" FontSize="11" />
                <TextBlock Text="{Binding DuplexCounts}" TextWrapping="Wrap" Classes="muted" FontSize="11" />
                <StackPanel Spacing="6" IsVisible="{Binding IsDuplexReview}" IsEnabled="{Binding CanConfigure}">
                  <CheckBox IsChecked="{Binding ReverseBacks}">
                    <TextBlock Text="Reverse back stack" FontSize="11" TextWrapping="Wrap" />
                  </CheckBox>
                  <TextBlock Text="Rotate all backs (°)" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="11" />
                  <ComboBox Width="86" HorizontalAlignment="Left" ItemsSource="{Binding BackRotations}" SelectedItem="{Binding BackRotation}" />
                </StackPanel>
                <CheckBox x:Name="DuplexReviewedCheck" IsVisible="{Binding IsDuplexReview}" IsEnabled="{Binding CanConfigure}"
                          IsChecked="{Binding DuplexReviewed}">
                  <TextBlock Text="I checked every pair and orientation" TextWrapping="Wrap" FontSize="11" />
                </CheckBox>
                <StackPanel>
                  <Button x:Name="ScanFrontsButton" Content="Scan fronts" IsVisible="{Binding ShowScanFronts}" Click="ScanFronts" IsEnabled="{Binding CanScanFronts}" Margin="0,0,8,6" />
                  <Button x:Name="ScanBacksButton" Content="Scan backs / more" IsVisible="{Binding ShowScanBacks}" Click="ScanBacks" IsEnabled="{Binding CanScanBacks}" Margin="0,0,8,6" />
                  <Button x:Name="ApplyDuplexButton" IsVisible="{Binding IsDuplexReview}" Classes="primary" Click="ApplyDuplex" IsEnabled="{Binding CanApplyDuplex}" HorizontalAlignment="Stretch" Margin="0,0,0,6">
                    <TextBlock Text="Apply reviewed order" FontSize="11" TextWrapping="Wrap" />
                  </Button>
                  <Button x:Name="KeepDuplexButton" FontSize="11" Click="KeepDuplexScanOrder" IsEnabled="{Binding CanConfigure}" HorizontalAlignment="Stretch" Margin="0,0,0,6"
                          ToolTip.Tip="End the guide; keep every completed front, then every completed back. Correct missing sheets manually.">
                    <TextBlock Text="Keep scan order / exit" TextWrapping="Wrap" />
                  </Button>
                </StackPanel>
              </StackPanel>
            </Border>
              <Expander Header="Scan settings" IsExpanded="{Binding ScanSettingsExpanded}" HorizontalAlignment="Stretch">
                <StackPanel Spacing="8">
                  <StackPanel Spacing="6">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Text="Saved preset" Classes="muted" FontSize="10" VerticalAlignment="Center" />
                      <Button x:Name="ManagePresetsButton" Grid.Column="1" Content="Save…" Click="ManagePresets" IsEnabled="{Binding CanConfigure}" Classes="quiet" Padding="6,3" ToolTip.Tip="Save current scan settings or update a saved preset" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                      <ComboBox x:Name="PresetPicker" ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}" IsEnabled="{Binding CanConfigure}" PlaceholderText="Choose a preset" />
                      <Button x:Name="ApplyPresetButton" Grid.Column="1" Content="Apply" Click="ApplyPreset" IsEnabled="{Binding CanApplyPreset}" Padding="8,4" ToolTip.Tip="Apply selected preset" />
                    </Grid>
                  </StackPanel>
                  <TextBlock x:Name="SettingsExplanation" Text="{Binding SettingsExplanation}" IsVisible="{Binding HasSettingsExplanation}" Classes="muted" FontSize="11" TextWrapping="Wrap" />
                  <StackPanel Spacing="4">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Text="Scanner" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                      <Button x:Name="RefreshDevicesButton" Grid.Column="1" Content="{Binding RefreshScannersLabel}" Classes="quiet" Padding="5" Click="RefreshDevices" ToolTip.Tip="Discover scanners" IsEnabled="{Binding CanRefreshScanners}" />
                    </Grid>
                    <ComboBox x:Name="DevicePicker" ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}" SelectionChanged="DeviceChanged" IsEnabled="{Binding CanConfigure}">
                      <ComboBox.ItemTemplate>
                        <DataTemplate>
                          <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding ID}" />
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock x:Name="ScannerStatusText" Text="{Binding ScannerStatus}" IsVisible="{Binding HasScannerStatus}"
                               ToolTip.Tip="{Binding ScannerStatus}" FontSize="9" Classes="muted" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                  <StackPanel Spacing="6">
                    <TextBlock Text="Paper source" Classes="muted" FontSize="11" />
                    <ComboBox ItemsSource="{Binding Sources}" SelectedItem="{Binding SelectedSource}" IsEnabled="{Binding CanChangeScanSettings}" x:Name="SourcePicker" />
                  </StackPanel>
                  <StackPanel Spacing="6">
                    <TextBlock Text="Color" Classes="muted" FontSize="11" />
                    <ComboBox ItemsSource="{Binding Colors}" SelectedItem="{Binding SelectedColor}" IsEnabled="{Binding CanChangeScanSettings}" x:Name="ColorPicker" />
                  </StackPanel>
                  <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <StackPanel Spacing="6">
                      <TextBlock Text="Resolution" Classes="muted" FontSize="11" />
                      <ComboBox ItemsSource="{Binding Resolutions}" SelectedItem="{Binding Dpi}" IsEnabled="{Binding CanChangeScanSettings}" x:Name="DpiPicker" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="6">
                      <TextBlock Text="Page size" Classes="muted" FontSize="11" />
                      <ComboBox ItemsSource="{Binding Sizes}" SelectedItem="{Binding SelectedSize}" IsEnabled="{Binding CanChangeScanSettings}" x:Name="SizePicker" ToolTip.Tip="Custom dimensions and scan area are in Settings → Paper geometry / area." />
                    </StackPanel>
                  </Grid>
                  <TextBlock x:Name="GeometryError" Text="{Binding GeometryError}" IsVisible="{Binding HasGeometryError}" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource ErrorBrush}" />
                </StackPanel>
              </Expander>
            </StackPanel>
          </ScrollViewer>
          <StackPanel Grid.Row="1" Spacing="6" Margin="0,8,0,0">
            <Button x:Name="ScanButton" Content="Scan pages" Classes="primary" HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center" IsEnabled="{Binding CanScan}" Click="ScanPages" />
            <Button x:Name="ManualDuplexButton" Content="Guided double-sided…" HorizontalAlignment="Stretch"
                    IsVisible="{Binding !HasDuplex}" IsEnabled="{Binding CanStartDuplex}" Click="BeginDuplex"
                    ToolTip.Tip="Use Document feeder for two single-sided passes." />
            <Button x:Name="BatchButton" Content="Batch setup / review…" IsEnabled="{Binding CanOpenBatch}" Click="OpenBatch" HorizontalAlignment="Stretch" />
            <Button x:Name="CancelButton" Content="Cancel operation" Click="CancelOperation" IsVisible="{Binding Busy}" HorizontalAlignment="Stretch" />
          </StackPanel>
        </Grid>
      </Border>

      <Grid Classes="document-area" Grid.Column="1" ColumnDefinitions="Auto,*" RowDefinitions="*,Auto" Margin="12">
        <Border x:Name="PreviewPanel" Grid.Column="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" CornerRadius="{DynamicResource AppRadius}" ClipToBounds="True">
          <Grid RowDefinitions="Auto,*,Auto">
            <Grid Margin="12,4" ColumnDefinitions="Auto,*">
              <TextBlock x:Name="SelectionCountText" Text="{Binding SelectionCount}" FontSize="10" Classes="muted" VerticalAlignment="Center" Margin="0,0,8,0" />
              <WrapPanel x:Name="PageToolbar" Grid.Column="1" HorizontalAlignment="Right" MaxWidth="700">
                <Button x:Name="UndoButton" Content="↶" Click="Undo" IsEnabled="{Binding CanUndo}" Classes="quiet" ToolTip.Tip="Undo · Ctrl+Z" />
                <Button x:Name="RedoButton" Content="↷" Click="Redo" IsEnabled="{Binding CanRedo}" Classes="quiet" ToolTip.Tip="Redo · Ctrl+Shift+Z" />
                <Button x:Name="DeskewButton" Content="Deskew" Click="DeskewPage" IsEnabled="{Binding CanChangePage}" Classes="quiet" />
                <Button x:Name="CropButton" Content="Crop" Click="CropPage" IsEnabled="{Binding CanChangePage}" Classes="quiet" />
                <Button x:Name="AdjustButton" Content="Adjust" Click="AdjustPage" IsEnabled="{Binding CanChangePage}" Classes="quiet" ToolTip.Tip="Brightness, contrast, sharpening, correction, angle and flipping" />
                <Button x:Name="RotateButton" Content="Rotate" Click="RotatePage" IsEnabled="{Binding CanEditSelection}" Classes="quiet" ToolTip.Tip="Rotate · R" />
                <Button x:Name="MoveEarlierButton" Content="←" Click="MoveEarlier" IsEnabled="{Binding CanEditSelection}" Classes="quiet" ToolTip.Tip="Move page earlier · Alt+Left" />
                <Button x:Name="MoveLaterButton" Content="→" Click="MoveLater" IsEnabled="{Binding CanEditSelection}" Classes="quiet" ToolTip.Tip="Move page later · Alt+Right" />
                <Button x:Name="RemoveButton" Content="Remove" Click="RemovePage" IsEnabled="{Binding CanEditSelection}" Classes="quiet" ToolTip.Tip="Remove from document · Delete. Undo restores it." />
              </WrapPanel>
            </Grid>
            <ScrollViewer x:Name="PreviewScroller" Grid.Row="1" Margin="6,4" IsVisible="{Binding HasPages}" Focusable="True"
                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
              <Image x:Name="SelectedPageImage" Source="{Binding Preview}" Stretch="Fill"
                     Width="{Binding Zoom.Width}" Height="{Binding Zoom.Height}"
                     HorizontalAlignment="Center" VerticalAlignment="Center" />
            </ScrollViewer>
            <TextBlock x:Name="ReorderHint" Grid.Row="1" VerticalAlignment="Top" HorizontalAlignment="Center" Background="{DynamicResource RaisedBrush}" Padding="12,6" IsVisible="False" />
            <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="18" IsVisible="{Binding IsEmpty}">
              <Border BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" Width="78" Height="102" CornerRadius="{DynamicResource AppRadius}" Opacity="0.8">
                <StackPanel Margin="16,28" Spacing="9">
                  <Border Height="2" Background="{DynamicResource AccentBrush}" />
                  <Border Height="2" Background="{DynamicResource BorderBrush}" />
                  <Border Height="2" Background="{DynamicResource BorderBrush}" Width="28" HorizontalAlignment="Left" />
                </StackPanel>
              </Border>
              <Button Content="Create your first session" Classes="primary" Click="NewSession" HorizontalAlignment="Center" IsVisible="{Binding !HasSession}" />
            </StackPanel>
            <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="10,2,6,4">
              <TextBlock Text="{Binding PreviewCaption}" Classes="muted" FontSize="9" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
              <WrapPanel Grid.Column="1" HorizontalAlignment="Right">
                <Button x:Name="ZoomOutButton" Content="−" Click="ZoomOut" Classes="quiet" ToolTip.Tip="Zoom out · Ctrl+Minus" />
                <TextBlock x:Name="ZoomLabel" Text="{Binding Zoom.Label}" VerticalAlignment="Center" MinWidth="80" TextAlignment="Center" FontSize="11" />
                <Button x:Name="ZoomInButton" Content="+" Click="ZoomIn" Classes="quiet" ToolTip.Tip="Zoom in · Ctrl+Plus or Ctrl+wheel. Drag preview to pan." />
                <Button x:Name="FitPageButton" Content="Fit page" Click="FitPage" Classes="quiet" ToolTip.Tip="Fit page · Ctrl+0" />
              </WrapPanel>
            </Grid>
          </Grid>
        </Border>

        <Grid RowDefinitions="Auto,*" IsVisible="{Binding HasPages}">
          <TextBlock x:Name="ThumbnailPageCount" Text="{Binding PageCount}" Classes="muted" FontSize="10"
                     HorizontalAlignment="Center" Margin="0,4,0,8" />
          <ListBox x:Name="PageTray" Grid.Row="1" ItemsSource="{Binding Pages}" SelectionMode="Multiple"
                   IsEnabled="{Binding CanConfigure}"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Hidden">
            <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="local:PagePreview">
                <StackPanel Spacing="4">
                  <Image Source="{Binding Thumbnail}" Stretch="Uniform" />
                  <TextBlock Text="{Binding Caption}" FontSize="9" HorizontalAlignment="Center" Foreground="{DynamicResource ForegroundBrush}" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
        <Border Grid.Row="1" Grid.ColumnSpan="2" Background="{DynamicResource RaisedBrush}" BorderBrush="{DynamicResource ErrorBrush}"
                BorderThickness="1" Padding="14,10" CornerRadius="{DynamicResource AppRadius}" IsVisible="{Binding HasError}">
          <TextBlock Text="{Binding Error}" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" FontSize="11" />
        </Border>
      </Grid>
    </Grid>

    <Border x:Name="ExportFooter" Classes="export-footer" Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
      <Grid Classes="export-layout" RowDefinitions="Auto,Auto,Auto">
        <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto" ColumnSpacing="10">
          <CheckBox x:Name="ExportSelectedCheckBox" IsChecked="{Binding ExportSelected}" IsEnabled="{Binding CanEdit}"
                    Content="Selected pages only" ToolTip.Tip="Applies to exporting, printing, and email. Otherwise, include every page." />
          <CheckBox x:Name="SearchablePdfCheckBox" Grid.Column="1" Content="Searchable PDF (OCR)" IsChecked="{Binding SearchablePdf}"
                    IsEnabled="{Binding CanConfigure}" ToolTip.Tip="Adds recognized text to separate or combined PDFs. Image export is unchanged." />
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" IsEnabled="{Binding CanChooseOcrLanguage}">
            <TextBlock Text="Language" VerticalAlignment="Center" FontSize="11" />
            <ComboBox x:Name="OcrLanguageSelector" ItemsSource="{Binding OcrLanguages}" SelectedItem="{Binding OcrLanguage}" Width="150" ToolTip.Tip="{Binding OcrStatus}" />
          </StackPanel>
          <TextBlock x:Name="OcrStatusText" Grid.Column="3" Text="{Binding OcrStatus}" ToolTip.Tip="{Binding OcrStatus}" TextTrimming="CharacterEllipsis"
                      VerticalAlignment="Center" Classes="muted" FontSize="10" />
          <Button x:Name="RefreshOcrButton" Grid.Column="4" Content="{Binding RefreshOcrLabel}" Classes="quiet" Click="RefreshOcr" IsEnabled="{Binding CanRefreshOcr}" ToolTip.Tip="{Binding OcrStatus}" />
        </Grid>
        <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Button x:Name="PrintButton" Content="Print…" Click="PrintDocument" IsEnabled="{Binding CanExport}" ToolTip.Tip="Print the current export scope through CUPS · Ctrl+P" />
            <Button x:Name="EmailButton" Content="Email PDF…" Click="EmailDocument" IsEnabled="{Binding CanExport}" ToolTip.Tip="Prepare a PDF and open your mail composer. Verify its attachment before sending." />
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
            <Button x:Name="ImagesExportButton" Content="Separate images" Click="ExportImages" IsEnabled="{Binding CanExport}" ToolTip.Tip="Choose PNG, JPEG or TIFF, with one numbered file per page" />
            <Button x:Name="SeparatePdfsButton" Content="Separate PDFs" Click="ExportPdfs" IsEnabled="{Binding CanExport}" ToolTip.Tip="One PDF per page, with compression, metadata and security options" />
            <Button x:Name="CombinedExportButton" Content="One document  →" Classes="primary" Click="ExportDocument" IsEnabled="{Binding CanExport}" ToolTip.Tip="Choose a combined PDF or multipage TIFF" />
          </StackPanel>
        </Grid>
        <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto,Auto" MinHeight="16">
          <ProgressBar x:Name="OperationProgress" Minimum="0" Maximum="1" Value="{Binding Progress}" IsIndeterminate="{Binding IndeterminateProgress}"
                       IsVisible="{Binding Busy}" Width="112" Height="4" MinWidth="0" MinHeight="0" Margin="0,0,12,0"
                       VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}" />
          <TextBlock x:Name="OperationStatus" Grid.Column="1" Text="{Binding Status}" ToolTip.Tip="{Binding Status}" Classes="muted" FontSize="11"
                     TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
          <TextBlock Grid.Column="2" Text="{Binding MailAttachment}" IsVisible="{Binding HasMailAttachment}" MaxWidth="180" Margin="12,0,0,0"
                     TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FontSize="10" Classes="muted" ToolTip.Tip="{Binding MailAttachment}" />
          <Button x:Name="CancelPrintButton" Grid.Column="3" Content="Cancel last print job" Classes="quiet" Click="CancelPrint"
                  IsVisible="{Binding CanCancelPrint}" IsEnabled="{Binding CanCancelPrint}" ToolTip.Tip="{Binding LastPrintJob}" Padding="0" Margin="12,0,0,0" />
        </Grid>
      </Grid>
    </Border>
  </Grid>
</Window>
